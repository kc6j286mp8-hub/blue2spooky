-- CREATE NEW IMAGE FOLDER
local Folder =
    Instance.new("Folder")
Folder.Name =
    "Realistic2DImage"
Folder.Parent =
    workspace
-- IMAGE SIZE
local StartX =
    -(Width - 1) * PixelSize / 2
local StartY =
    (Height - 1) * PixelSize / 2
-- SPAWN THE IMAGE IN FRONT OF THE PLAYER
local ImageCFrame =
    Root.CFrame
    * CFrame.new(0, 0, -6)
    * CFrame.Angles(0, math.rad(180), 0)
-- BUILD IMAGE
for i = 1, #Pixels do
    local ColorIndex =
        Pixels[i]
    if ColorIndex > 0 then
        local ZeroIndex =
            i - 1
        local X =
            ZeroIndex % Width
        local Y =
            math.floor(
                ZeroIndex / Width
            )
        local Part =
            Instance.new("Part")
        Part.Name =
            "Pixel"
        Part.Size =
            Vector3.new(
                PixelSize,
                PixelSize,
                0.01
            )
        Part.CFrame =
            ImageCFrame
            * CFrame.new(
                StartX + X * PixelSize,
                StartY - Y * PixelSize,
                0
            )
        Part.Color =
            Colors[ColorIndex]
        Part.Anchored =
            true
        Part.CanCollide =
            false
        Part.CanTouch =
            false
        Part.CanQuery =
            false
        Part.CastShadow =
            false
        Part.TopSurface =
            Enum.SurfaceType.Smooth
        Part.BottomSurface =
            Enum.SurfaceType.Smooth
        Part.Parent =
            Folder
    end
end
